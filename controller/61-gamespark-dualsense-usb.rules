# A DualSense (054C:0CE6) or DualSense Edge (054C:0DF2) plugged in by USB while it is still connected over Bluetooth:
# the kernel refuses the USB pad as a duplicate, so games keep the Bluetooth link and get no haptics (USB audio only).
# dualsense-usb.sh drops the Bluetooth link and re-probes the USB HID interface. Installed by
# system/fex-system.sh controllers.
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", ATTR{bInterfaceClass}=="03", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0ce6|0df2", RUN+="/usr/bin/systemd-run --no-block --collect /usr/local/lib/gamespark/dualsense-usb.sh %k"
