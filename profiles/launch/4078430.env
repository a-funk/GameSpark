# STAR WARS: Galactic Racer (Unreal Engine 5, DirectX 12 via VKD3D-Proton; Denuvo, Epic Online Services)
# DLSS and DLSS frame generation need NVIDIA's API exposed to the game.
PROTON_ENABLE_NVAPI=1
# Denuvo needs two things stock FEX 2610 lacks (docs/FINDINGS.md): Proton must catch the game's direct Windows syscalls
# (FEX's seccomp emulation, off by default, plus a fix to how it raises SIGSYS), and x86 hardware execute breakpoints
# set through wineserver's ptrace calls must fire. Both come from GameSpark's patched FEX (system/fex-patched.sh).
FEX_BINARY=gamespark
FEX_NEEDSSECCOMP=1
FEX_GSHWBP=1
# Only the 10 Cortex-X925 cores, from the first thread on. Wine gives each new thread the CPU mask the process started
# with, so pinning after launch did not hold (172 of 181 threads were back on all 20 cores) and a hitch about once a
# second followed main threads onto the A725 cores. The game also sizes its worker pool to the 10 CPUs it is shown.
# Not a general rule: Cyberpunk lost 8% this way, its job workers need all 20.
PROTON_CPU_TOPOLOGY=10:5,6,7,8,9,15,16,17,18,19
# Audio dropouts under load: Wine asked PipeWire for so little buffering that the HDMI output ran 128-sample (2.7 ms)
# cycles and underran. 90 ms requested latency gives 1024-sample cycles.
PULSE_LATENCY_MSEC=90
# Proton's Xalia (controller navigation for launchers) is not needed: the game has its own controller support.
PROTON_USE_XALIA=0
# profiles/launch/4078430.Engine.ini (Nanite off) goes to this game's config folder before every launch.
UE_PROJECT=StarWarsGalacticRacer
