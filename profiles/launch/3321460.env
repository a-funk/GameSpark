# Crimson Desert (Pearl Abyss 2026: BlackSpace Engine, DirectX 12 through VKD3D-Proton; Denuvo, 5 PCs/day activation limit)
# summary: not playable yet: Denuvo passes (patched FEX), but the game waits forever on its intro video (see docs/FINDINGS.md)
# Denuvo: start on GameSpark's patched FEX from the very first launch (each new runtime can count as a new machine against
# the activation limit), on the Proton that still has the seccomp syscall trap (GameSpark-Proton-Exp-20261008).
FEX_BINARY=gamespark
FEX_NEEDSSECCOMP=1
FEX_GSHWBP=1
FEX_GSSMCWX=1
# DLSS / DLSS frame generation need NVIDIA's API exposed to the game.
PROTON_ENABLE_NVAPI=1
# Audio underruns at 128-sample cycles under load (Galactic Racer): ask PipeWire for 90 ms.
PULSE_LATENCY_MSEC=90
# The game has its own controller support; Xalia used a third of a core in other games.
PROTON_USE_XALIA=0
# NVIDIA 615 busy-waits for each present in VKD3D-Proton's swapchain thread (Hades II, Street Fighter 6).
__GL_YIELD=USLEEP
# Controllers (Street Fighter 6's fix): Steam's virtual pads carry no input on this machine (32-bit Steam client under
# FEX); the game would only read a DualSense as one over USB. Proton shows the real DualSense to the game as an XInput pad
# (through SDL, not raw HID) and hides Steam's virtual pads.
SteamVirtualGamepadInfo=/dev/null
SteamVirtualGamepadInfo_Proton=/dev/null
SDL_GAMECONTROLLER_IGNORE_DEVICES=0x28de/0x11ff
PROTON_DISABLE_HIDRAW=0x054c/0x0ce6,0x054c/0x0df2
# First launches only: Proton log in ~/steam-3321460.log. Remove once it runs.
PROTON_LOG=1
