# The Witcher 3: Wild Hunt (next-gen, 4.x)
# Skip CDPR's REDprelauncher; the graphics API comes from launcher-configuration.json ("fallback"), which
# bench/games/witcher3.sh sets per run.
EXTRA_ARGS=--launcher-skip
# DLSS (upscaling and frame generation) needs NVIDIA's API exposed to the game.
PROTON_ENABLE_NVAPI=1
