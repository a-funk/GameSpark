# The Witcher 3: Wild Hunt (next-gen, 4.x)
# Skip CDPR's REDprelauncher; the game is DirectX 12 only and its graphics settings are in dx12user.settings, which
# bench/games/witcher3.sh sets per run.
EXTRA_ARGS=--launcher-skip
# DLSS needs NVIDIA's API exposed to the game.
PROTON_ENABLE_NVAPI=1
# The main loop asks wininet "am I online?" ~10 times a second; Wine answers each with a full network-interface scan
# (~35 ms under FEX), a hitch every ~100 ms. The shim caches the answer (system/shim.sh install 292030).
SHIM=powrprof@bin/x64_dx12
WINEDLLOVERRIDES=powrprof=n,b
