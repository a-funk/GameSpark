# Divinity: Original Sin 2 - Definitive Edition
# Skip the Larian launcher (an embedded browser) and start the game itself.
SWAP_FROM=/bin/SupportTool.exe
SWAP_TO=/DefEd/bin/EoCApp.exe
# Proton hands DualSense pads to the game as raw HID, which this XInput-only game ignores (player 2 could not
# join); without hidraw, Wine's SDL backend presents them as XInput pads.
PROTON_DISABLE_HIDRAW=0x054c/0x0ce6,0x054c/0x0df2
