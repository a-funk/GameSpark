diff --git a/FEXCore/Source/Interface/Core/Frontend.cpp b/FEXCore/Source/Interface/Core/Frontend.cpp
index bffd784..c2ec644 100644
--- a/FEXCore/Source/Interface/Core/Frontend.cpp
+++ b/FEXCore/Source/Interface/Core/Frontend.cpp
@@ -1742,6 +1742,25 @@ void Decoder::DecodeLoop(const uint8_t* _InstStream, uint64_t GuestSizePause) {
     Block.IsEntryPoint = BlockInfo.EntryPoints.contains(Block.Entry);
   }
 
+  // Local GameSpark patch (FEX_GSSMCWX): blocks with code on pages that were made writable while holding code check
+  // each instruction's bytes before running it (Core.cpp), however they are entered: dispatcher, block link or return.
+  {
+    uint64_t CodeMin = ~0ULL, CodeEnd = 0;
+    for (const auto& Block : BlockInfo.Blocks) {
+      if (Block.Size) {
+        CodeMin = std::min(CodeMin, Block.Entry);
+        CodeEnd = std::max(CodeEnd, Block.Entry + Block.Size);
+      }
+    }
+    if (CodeMin < CodeEnd && CTX->SyscallHandler->NeedsFullSMCChecks(Thread, CodeMin, CodeEnd)) [[unlikely]] {
+      for (auto& Block : BlockInfo.Blocks) {
+        if (Block.Size && CTX->SyscallHandler->NeedsFullSMCChecks(Thread, Block.Entry, Block.Entry + Block.Size)) {
+          Block.ForceFullSMCDetection = true;
+        }
+      }
+    }
+  }
+
   // now that multiblock has settled down, remove any branch masks we put down that didn't end the block
   if (WantsDataMasks) {
     PruneInlinedBranchDataMasks();
