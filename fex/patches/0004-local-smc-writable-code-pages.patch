 static void HandleSegfaultForCodeCacheFinalization(FEXCore::Core::InternalThreadState& Thread, FEXCore::MappedCodeCacheFile& Code,
                                                    uintptr_t FaultAddress) {
   FEXCORE_PROFILE_SCOPED("Load code cache page");
@@ -145,6 +164,13 @@ void SyscallHandler::MarkGuestExecutableRange(FEXCore::Core::InternalThreadState
 
     auto lk = FEXCore::GuardSignalDeferringSection<std::shared_lock>(VMATracking.Mutex, Thread);
 
+    // Local GameSpark patch (FEX_GSSMCWX): code on these pages checks itself, so leave them writable. Write-protecting
+    // them also broke writes from other processes: wineserver performs NtWriteVirtualMemory with process_vm_writev,
+    // which fails on a page mprotected read-only here (kernelbase's WriteProcessMemory to a code page).
+    if (HasWXPages.load(std::memory_order_relaxed) && WXPages.Contains({Base, Top})) {
+      return;
+    }
+
     // Find the first mapping at or after the range ends, or ::end().
     // Top points to the address after the end of the range
     auto Mapping = VMATracking.VMAs.lower_bound(Top);
@@ -217,6 +243,67 @@ SyscallHandler::LookupExecutableFileSection(FEXCore::Core::InternalThreadState*
   return BuildSectionInfo(*Entry.Resource, MappingBaseAddr, Entry.Length);
 }
 
+// Local GameSpark patch (FEX_GSSMCWX): asked by the frontend for the blocks it decodes.
+bool SyscallHandler::NeedsFullSMCChecks(FEXCore::Core::InternalThreadState* Thread, uint64_t Start, uint64_t End) {
+  if (!HasWXPages.load(std::memory_order_acquire)) {
+    return false;
+  }
+  auto lk = FEXCore::GuardSignalDeferringSection<std::shared_lock>(VMATracking.Mutex, Thread);
+  return WXPages.Intersect({Start, End});
+}
+
+// Local GameSpark patch (FEX_GSSMCWX). Called by TrackMprotect before the VMAs take the new protection; GuestMprotect
+// then invalidates the range, so code translated before a page was marked is dropped and translated again with checks.
+// - VMATracking.Mutex must be unique_locked
+void SyscallHandler::TrackWXPages(uint64_t Base, uint64_t Top, int Prot) {
+  if (!(Prot & PROT_WRITE)) {
+    // No longer writable: the range's code is invalidated, and it cannot change again without another mprotect.
+    UntrackWXPages(Base, Top);
+    return;
+  }
+
+  auto Add = [this, Prot](uint64_t Start, uint64_t End) {
+    WXPages.Insert({Start, End});
+    HasWXPages.store(true, std::memory_order_release);
+    if (GSSMCWXLog()) {
+      fprintf(stderr, "FEX GSSMCWX: pid %d checks code on 0x%lx-0x%lx (mprotect prot %d)\n", ::getpid(), (unsigned long)Start,
+              (unsigned long)End, Prot);
+    }
+  };
+
+  if (GSSMCWXMode() == 2 && (Prot & PROT_EXEC)) {
+    Add(Base, Top);
+    return;
+  }
+
+  // Pages that hold code (are executable) and become writable: code patched in place, like Denuvo's hooks of ntdll.
+  // Marked pages stay marked while writable, so code made writable without exec and then RWX keeps its mark.
+  auto Mapping = VMATracking.VMAs.upper_bound(Base);
+  if (Mapping != VMATracking.VMAs.begin()) {
+    --Mapping;
+  }
+  for (; Mapping != VMATracking.VMAs.end() && Mapping->first < Top; ++Mapping) {
+    const auto MapTop = Mapping->first + Mapping->second.Length;
+    if (MapTop > Base && Mapping->second.Prot.Executable) {
+      Add(std::max(Base, Mapping->first), std::min(Top, MapTop));
+    }
+  }
+}
+
+// - VMATracking.Mutex must be unique_locked
+void SyscallHandler::UntrackWXPages(uint64_t Base, uint64_t Top) {
+  if (!HasWXPages.load(std::memory_order_relaxed) || !WXPages.Intersect({Base, Top})) {
+    return;
+  }
+  WXPages.Remove({Base, Top});
+  if (WXPages.Empty()) {
+    HasWXPages.store(false, std::memory_order_relaxed);
+  }
+  if (GSSMCWXLog()) {
+    fprintf(stderr, "FEX GSSMCWX: pid %d stops checking code on 0x%lx-0x%lx\n", ::getpid(), (unsigned long)Base, (unsigned long)Top);
+  }
+}
+
 FEXCore::HLE::ExecutableRangeInfo SyscallHandler::QueryGuestExecutableRange(FEXCore::Core::InternalThreadState* Thread, uint64_t Address) {
   auto lk = FEXCore::GuardSignalDeferringSection<std::shared_lock>(VMATracking.Mutex, Thread);
   auto ThreadObject = FEX::HLE::ThreadManager::GetStateObjectFromFEXCoreThread(Thread);
@@ -615,6 +702,12 @@ SyscallHandler::TrackMmap(FEXCore::Core::InternalThreadState* Thread, uint64_t a
 
   VMATracking::MappedResource* Resource = nullptr;
 
+  // Local GameSpark patch (FEX_GSSMCWX): a new mapping starts unmarked; FEX_GSSMCWX=2 marks a writable+executable one.
+  UntrackWXPages(addr, addr + Size);
+  if (GSSMCWXMode() == 2 && SMCChecks == FEXCore::Config::CONFIG_SMC_MTRACK && (prot & PROT_WRITE) && (prot & PROT_EXEC)) {
+    TrackWXPages(addr, addr + Size, prot);
+  }
+
   std::optional<SyscallHandler::LateApplyExtendedVolatileMetadata> VolatileMetadata = std::nullopt;
 
   if (!(flags & MAP_ANONYMOUS)) {
@@ -785,11 +878,16 @@ void SyscallHandler::AddVirtualPage(FEXCore::Core::InternalThreadState* Thread,
 void SyscallHandler::TrackMunmap(FEXCore::Core::InternalThreadState* Thread, void* addr, size_t length) {
   uint64_t Size = FEXCore::AlignUp(length, FEXCore::Utils::FEX_PAGE_SIZE);
   VMATracking.DeleteVMARange(CTX, reinterpret_cast<uintptr_t>(addr), Size);
+  UntrackWXPages(reinterpret_cast<uintptr_t>(addr), reinterpret_cast<uintptr_t>(addr) + Size); // Local GameSpark patch
 }
 
 void SyscallHandler::TrackMprotect(FEXCore::Core::InternalThreadState* Thread, void* addr, size_t len, int prot) {
   uint64_t Size = FEXCore::AlignUp(len, FEXCore::Utils::FEX_PAGE_SIZE);
 
+  if (GSSMCWXMode() && SMCChecks == FEXCore::Config::CONFIG_SMC_MTRACK) [[unlikely]] {
+    // Local GameSpark patch: before the VMAs change, TrackWXPages reads which pages held code.
+    TrackWXPages(reinterpret_cast<uintptr_t>(addr), reinterpret_cast<uintptr_t>(addr) + Size, prot);
+  }
   VMATracking.ChangeProtectionFlags(reinterpret_cast<uintptr_t>(addr), Size, VMATracking::VMAProt::fromProt(prot));
 }
 
