 namespace FEX::HLE {
+// Local GameSpark patch: FEX_GSSMCWX=1 (or 2) enables WXPages with SMCChecks=mtrack; FEX_GSSMCWX_LOG=1 logs its changes.
+static int GSSMCWXMode() {
+  static const int Mode = [] {
+    const char* Env = getenv("FEX_GSSMCWX");
+    return Env && (Env[0] == '1' || Env[0] == '2') ? Env[0] - '0' : 0;
+  }();
+  return Mode;
+}
+
+static bool GSSMCWXLog() {
+  static const bool Log = [] {
+    const char* Env = getenv("FEX_GSSMCWX_LOG");
+    return Env && Env[0] == '1';
+  }();
+  return Log;
+}
