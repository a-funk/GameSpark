 #include <FEXCore/HLE/SyscallHandler.h>
 #include <FEXCore/Utils/Allocator.h>
 #include <FEXCore/Utils/CompilerDefs.h>
@@ -40,6 +41,7 @@ $end_info$
 #include <FEXCore/fextl/vector.h>
 #include <FEXHeaderUtils/Filesystem.h>
 #include <FEXHeaderUtils/Syscalls.h>
+#include "LinuxSyscalls/HWBP.h"
 
 #include <algorithm>
 #include <alloca.h>
@@ -909,6 +911,75 @@ void SyscallHandler::HandleSyscall(FEXCore::Core::CpuStateFrame* Frame) {
   // Skip past the `syscall` or `int 0x80` instruction. Both of which are 2-bytes.
   auto Thread = FEX::HLE::ThreadManager::GetStateObjectFromCPUState(Frame);
   Thread->Thread->CurrentFrame->State.rip += 2;
+
+  if (Is64Bit && FEX::HLE::HWBP::Enabled()) [[unlikely]] {
+    // Local experiment (GameSpark): pick up debug registers that the tracer (wineserver) wrote into our mailbox.
+    if (!Thread->HWBPMailbox) {
+      if (!Thread->HWBPTried) {
+        Thread->HWBPTried = true;
+        Thread->HWBPMailbox = FEX::HLE::HWBP::CreateLocal(FHU::Syscalls::gettid());
+      }
+      return;
+    }
+    auto* MB = static_cast<FEX::HLE::HWBP::Mailbox*>(Thread->HWBPMailbox);
+    auto& HW = *Thread->Thread->CurrentFrame; // hwbp_* live in the frame, outside CPUState
+    const uint64_t Version = MB->Version.load(std::memory_order_acquire);
+    if (Version == Thread->HWBPAppliedVersion) {
+      if (HW.hwbp_dr6 != Thread->HWBPPublishedDR6) {
+        MB->DR[6] = HW.hwbp_dr6;
+        Thread->HWBPPublishedDR6 = HW.hwbp_dr6;
+      }
+      return;
+    }
+    Thread->HWBPAppliedVersion = Version;
+    const uint64_t DR7 = MB->DR[7];
+    uint64_t NewMask {};
+    uint64_t NewAddr[4];
+    for (uint32_t i = 0; i < 4; ++i) {
+      NewAddr[i] = MB->DR[i];
+      const bool Enabled = (DR7 >> (i * 2)) & 3;
+      const uint32_t RW = (DR7 >> (16 + i * 4)) & 3;
+      if (!Enabled) {
+        continue;
+      }
+      if (RW == 0) {
+        NewMask |= 1ULL << i;
+      } else {
+        LogMan::Msg::IFmt("HWBP: data breakpoint DR{} (type {}) at 0x{:x} is not supported", i, RW, NewAddr[i]);
+      }
+    }
+    HW.hwbp_dr6 = MB->DR[6];
+    Thread->HWBPPublishedDR6 = MB->DR[6];
+    const uint64_t OldMask = HW.hwbp_mask;
+    uint64_t OldAddr[4];
+    memcpy(OldAddr, HW.hwbp_addr, sizeof(OldAddr));
+    for (uint32_t i = 0; i < 4; ++i) {
+      if (NewMask & (1ULL << i)) {
+        CTX->HWBPAddressRef(NewAddr[i], true);
+      }
+    }
+    memcpy(HW.hwbp_addr, NewAddr, sizeof(NewAddr));
+    HW.hwbp_mask = NewMask;
+    for (uint32_t i = 0; i < 4; ++i) {
+      if (OldMask & (1ULL << i)) {
+        CTX->HWBPAddressRef(OldAddr[i], false);
+      }
+    }
+    // Recompile around newly armed addresses so they start a unit with the entry check.
+    for (uint32_t i = 0; i < 4; ++i) {
+      if ((NewMask & (1ULL << i)) && !((OldMask & (1ULL << i)) && OldAddr[i] == NewAddr[i])) {
+        TM.InvalidateGuestCodeRange(Thread->Thread, NewAddr[i], 1);
+        // InvalidateThreadCachedCodeRange clears the call-return stack only if this thread cached a block on that
+        // page; a pending return into code compiled before the arm would otherwise skip the entry check.
+        FEXCore::Allocator::VirtualDontNeed(Thread->Thread->CallRetStackBase, FEXCore::Core::InternalThreadState::CALLRET_STACK_SIZE);
+      }
+    }
+    if (getenv("FEX_GSHWBP_LOG")) {
+      fprintf(stderr, "FEX HWBP: tid %u DR7=0x%lx exec-mask=0x%lx DR0-3=%lx %lx %lx %lx\n", (unsigned)FHU::Syscalls::gettid(),
+              (unsigned long)DR7, (unsigned long)NewMask, (unsigned long)NewAddr[0], (unsigned long)NewAddr[1],
+              (unsigned long)NewAddr[2], (unsigned long)NewAddr[3]);
+    }
+  }
 }
 
