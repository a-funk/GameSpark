+void Arm64JITCore::EmitHWBPCheck(uint64_t RIP) {
+  // Local experiment (GameSpark): raise a guest #DB if this thread has an execute breakpoint armed at RIP.
+  ARMEmitter::ForwardLabel l_NoHit;
+  ldr(TMP1, STATE_PTR(CpuStateFrame, hwbp_mask));
+  (void)cbz(ARMEmitter::Size::i64Bit, TMP1, &l_NoHit);
+  LoadConstant(ARMEmitter::Size::i64Bit, TMP2, RIP);
+  for (uint32_t i = 0; i < 4; ++i) {
+    ARMEmitter::ForwardLabel l_Next;
+    (void)tbz(TMP1, i, &l_Next);
+    ldr(TMP3, STATE, offsetof(FEXCore::Core::CpuStateFrame, hwbp_addr) + i * 8);
+    // NZCV holds the guest's flags at block entry: compare without touching them.
+    sub(ARMEmitter::Size::i64Bit, TMP3, TMP3, TMP2);
+    (void)cbnz(ARMEmitter::Size::i64Bit, TMP3, &l_Next);
+    LoadConstant(ARMEmitter::Size::i64Bit, TMP3, 0xFFFF0FF0ULL | (1ULL << i));
+    str(TMP3, STATE_PTR(CpuStateFrame, hwbp_dr6));
+    str(TMP2, STATE_PTR(CpuStateFrame, State.rip));
+    Core::CpuStateFrame::SynchronousFaultDataStruct FaultState = {
+      .FaultToTopAndGeneratedException = 1,
+      .Signal = Core::FAULT_SIGTRAP,
+      .TrapNo = X86State::X86_TRAPNO_DB,
+      .si_code = 4, // TRAP_HWBKPT
+      .err_code = 0,
+    };
+    uint64_t Constant {};
+    memcpy(&Constant, &FaultState, sizeof(FaultState));
+    LoadConstant(ARMEmitter::Size::i64Bit, TMP3, Constant);
+    str(TMP3, STATE, offsetof(FEXCore::Core::CpuStateFrame, SynchronousFaultData));
+    ldr(TMP3, STATE, offsetof(FEXCore::Core::CpuStateFrame, Pointers.GuestSignal_SIGTRAP));
+    br(TMP3);
+    (void)Bind(&l_Next);
+  }
+  (void)Bind(&l_NoHit);
+}
