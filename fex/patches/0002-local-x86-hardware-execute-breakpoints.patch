+  void HWBPAddressRef(uint64_t Address, bool Add) override {
+    // Signals masked while held: a guest signal handler running on top of this frame (Wine's SIGQUIT exits the
+    // thread) would otherwise leave the lock taken.
+    auto lk = FEXCore::MaskSignalsAndLockMutex(HWBPLock);
+    if (Add) {
+      if (HWBPRefs[Address]++ == 0) {
