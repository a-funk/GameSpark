+    }
+  }
+  bool IsHWBPAddress(uint64_t Address) {
+    if (HWBPCount.load(std::memory_order_acquire) == 0) {
+      return false;
+    }
+    std::shared_lock lk(HWBPLock);
+    return HWBPRefs.contains(Address);
+  }
+  std::shared_mutex HWBPLock;
+  fextl::unordered_map<uint64_t, uint32_t> HWBPRefs;
+  std::atomic<uint32_t> HWBPCount {};
