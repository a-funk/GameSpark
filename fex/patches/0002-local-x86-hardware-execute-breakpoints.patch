new file mode 100644
index 0000000..7e48dad
--- /dev/null
+++ b/Source/Tools/LinuxEmulation/LinuxSyscalls/HWBP.h
@@ -0,0 +1,106 @@
+// SPDX-License-Identifier: MIT
+// Local experiment (GameSpark; not for upstream): x86 hardware execute breakpoints for Wine guests.
+// wineserver sets debug registers with ptrace(PTRACE_POKEUSER, tid, offsetof(struct user, u_debugreg[i]), value).
+// Tracer and tracee are separate FEX processes, so the values travel through a per-thread shared-memory mailbox,
+// /dev/shm/fexhwbp-<tid>, which each tracee thread creates and applies at its next syscall return.
+#pragma once
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <dirent.h>
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+namespace FEX::HLE::HWBP {
+struct Mailbox {
+  std::atomic<uint64_t> Version; // bumped by the tracer after each write
+  uint64_t DR[8];
+};
+static_assert(sizeof(Mailbox) <= 4096);
+
+constexpr uint64_t DEBUGREG_OFFSET = 848; // offsetof(struct user, u_debugreg) on x86-64
+constexpr size_t MAILBOX_SIZE = 4096;
+
+inline bool Enabled() {
+  static const bool Value = [] {
+    const char* Env = getenv("FEX_GSHWBP");
+    return Env && Env[0] == '1';
+  }();
+  return Value;
+}
+
+inline void MailboxPath(char* Buf, size_t Size, uint32_t TID) {
+  snprintf(Buf, Size, "/dev/shm/fexhwbp-%u", TID);
+}
+
+// Tracer side: map another thread's mailbox; nullptr if that thread has none (not a FEX guest with this enabled).
+inline Mailbox* OpenRemote(uint32_t TID) {
+  char Path[64];
+  MailboxPath(Path, sizeof(Path), TID);
+  const int FD = open(Path, O_RDWR | O_CLOEXEC);
+  if (FD < 0) {
+    return nullptr;
+  }
+  void* Ptr = mmap(nullptr, MAILBOX_SIZE, PROT_READ | PROT_WRITE, MAP_SHARED, FD, 0);
+  close(FD);
+  return Ptr == MAP_FAILED ? nullptr : static_cast<Mailbox*>(Ptr);
+}
+
+inline void CloseRemote(Mailbox* MB) {
+  munmap(MB, MAILBOX_SIZE);
+}
+
+// Tracee side: create the calling thread's mailbox. The first call in a process also removes mailboxes of threads
+// that no longer exist (left behind by crashes or exit_group).
+inline Mailbox* CreateLocal(uint32_t TID) {
+  static std::atomic<bool> CleanedStale {};
+  if (!CleanedStale.exchange(true)) {
+    if (DIR* D = opendir("/dev/shm")) {
+      while (auto* E = readdir(D)) {
+        unsigned Tid {};
+        if (sscanf(E->d_name, "fexhwbp-%u", &Tid) == 1) {
+          char Proc[64];
+          snprintf(Proc, sizeof(Proc), "/proc/%u", Tid);
+          if (access(Proc, F_OK) != 0) {
+            char Stale[64];
+            MailboxPath(Stale, sizeof(Stale), Tid);
+            unlink(Stale);
+          }
+        }
+      }
+      closedir(D);
+    }
+  }
+  char Path[64];
+  MailboxPath(Path, sizeof(Path), TID);
+  const int FD = open(Path, O_RDWR | O_CREAT | O_TRUNC | O_CLOEXEC, 0600);
+  if (FD < 0) {
+    return nullptr;
+  }
+  // tmpfs allocates on first touch: reserve the page now so a full /dev/shm fails here, not as SIGBUS later.
+  if (posix_fallocate(FD, 0, MAILBOX_SIZE) != 0) {
+    close(FD);
+    unlink(Path);
+    return nullptr;
+  }
+  void* Ptr = mmap(nullptr, MAILBOX_SIZE, PROT_READ | PROT_WRITE, MAP_SHARED, FD, 0);
+  close(FD);
+  if (Ptr == MAP_FAILED) {
+    unlink(Path);
+    return nullptr;
+  }
+  return static_cast<Mailbox*>(Ptr);
+}
+
+inline void DestroyLocal(void* MB, uint32_t TID) {
+  if (!MB) {
+    return;
+  }
+  munmap(MB, MAILBOX_SIZE);
+  char Path[64];
+  MailboxPath(Path, sizeof(Path), TID);
+  unlink(Path);
+}
+} // namespace FEX::HLE::HWBP
